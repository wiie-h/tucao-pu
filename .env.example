# ============================================================
# 复制成 .env 再改成你自己的值：cp .env.example .env
# ============================================================

# 你的域名（不要带 https:// 前缀，不要带结尾斜杠）
DOMAIN = tucao.example.com

# 站点对外地址（本地开发保持默认即可）
BASE_URL = https://tucao.example.com

# 站点名字
SITE_NAME = 吐槽铺

# 后台密码：请务必改成你自己的，越长越好
# 生成一个随机密码：openssl rand -base64 24
ADMIN_PASSWORD = 换成你自己的密码

# 访客去重用的随机盐。换了它历史的「独立访客」口径会重算。
# 生成：openssl rand -hex 32
IP_SALT = 换成你自己的随机串

# 联系邮箱，会显示在「关于本站」页面
CONTACT_EMAIL = hi@example.com

# 是否先审后发：1 = 每条都要你审核后才公开，0 = 先发后审（默认）
REQUIRE_REVIEW = 0

# 端口（用 docker-compose 时不用改）
PORT = 3000

# 额外屏蔽词，用英文逗号分隔。命中后自动进入待审，不会公开。
# 例：BANNED_WORDS = 某某公司,某个名字
BANNED_WORDS =
