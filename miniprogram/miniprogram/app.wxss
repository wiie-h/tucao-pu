/* 吐槽铺 · 全局样式（沿用网页版的纸感配色） */
page {
  background: #FBF3E4;
  color: #241F1A;
  font-size: 30rpx;
  line-height: 1.7;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
}

.page-wrap {
  padding: 24rpx 28rpx 60rpx;
}

/* 顶部标语 */
.marquee {
  background: #241F1A;
  color: #FBEFDC;
  font-size: 22rpx;
  padding: 10rpx 28rpx;
  letter-spacing: 2rpx;
}

/* 卡片 */
.card {
  background: #FFFCF6;
  border: 1rpx solid rgba(36, 31, 26, 0.12);
  border-radius: 28rpx;
  padding: 32rpx 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(36, 31, 26, 0.07);
}

/* 按钮 */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  height: 88rpx;
  line-height: 1;
}
.btn::after { border: none; }
.btn-primary {
  background: #FF4D3D;
  color: #fff;
  box-shadow: 0 6rpx 0 #C9341F;
}
.btn-primary.btn-hover { transform: translateY(4rpx); box-shadow: none; }
.btn-ghost {
  background: #FFFCF6;
  color: #241F1A;
  border: 2rpx solid rgba(36, 31, 26, 0.14);
  box-shadow: 0 6rpx 0 rgba(36, 31, 26, 0.10);
}
.btn-ghost.btn-hover { transform: translateY(4rpx); box-shadow: none; }
.btn-danger {
  background: #241F1A;
  color: #FFE9E4;
  box-shadow: 0 6rpx 0 #000;
}

.muted { color: #8C8178; font-size: 24rpx; }
.row { display: flex; align-items: center; }
.grow { flex: 1; min-width: 0; }

/* 便利贴 */
.note {
  border-radius: 26rpx 26rpx 26rpx 8rpx;
  padding: 30rpx 28rpx 24rpx;
  margin-bottom: 26rpx;
  box-shadow: 0 6rpx 20rpx rgba(36, 31, 26, 0.08);
  position: relative;
}
.note-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.note-mood {
  font-size: 24rpx;
  font-weight: 700;
  padding: 4rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.6);
}
.note-time { font-size: 22rpx; opacity: 0.6; }
.note-text {
  font-size: 31rpx;
  line-height: 1.75;
  word-break: break-word;
  white-space: pre-wrap;
}
.note-tags { display: flex; flex-wrap: wrap; margin-top: 18rpx; }
.note-tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.55);
  margin: 0 12rpx 10rpx 0;
}
.note-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 1rpx dashed rgba(36, 31, 26, 0.16);
}
.note-nick { font-size: 24rpx; opacity: 0.85; max-width: 46%; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.note-acts { display: flex; align-items: center; }
.act {
  font-size: 24rpx;
  font-weight: 600;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.62);
  margin-left: 14rpx;
}
.act-on { background: #241F1A; color: #FBEFDC; }

/* 回复 */
.replies { margin-top: 20rpx; }
.reply {
  background: rgba(255, 255, 255, 0.55);
  border-radius: 18rpx;
  padding: 16rpx 20rpx;
  margin-top: 12rpx;
  font-size: 27rpx;
  line-height: 1.65;
}
.reply-meta { font-size: 22rpx; opacity: 0.6; margin-bottom: 4rpx; }

/* 空状态 */
.empty { text-align: center; padding: 120rpx 0; color: #8C8178; }
.empty-icon { font-size: 90rpx; }

/* 药丸标签 */
.chips { display: flex; flex-wrap: wrap; }
.chip {
  font-size: 26rpx;
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  background: #FBF3E4;
  border: 2rpx solid rgba(36, 31, 26, 0.12);
  margin: 0 16rpx 16rpx 0;
}
.chip-on { background: #241F1A; color: #FBEFDC; border-color: #241F1A; }
.chip-mood-on { border-width: 2rpx; font-weight: 700; }
