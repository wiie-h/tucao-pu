.loading { text-align: center; padding: 80rpx 0; }

.ops { display: flex; margin: 4rpx 0 26rpx; }
.op {
  font-size: 25rpx;
  color: #574E47;
  background: rgba(36, 31, 26, 0.06);
  border-radius: 999rpx;
  padding: 10rpx 24rpx;
  margin-right: 16rpx;
}

.replies-card { margin-top: 10rpx; }
.label { font-size: 25rpx; color: #8C8178; margin-bottom: 16rpx; letter-spacing: 2rpx; }

.reply-form { display: flex; align-items: center; margin-top: 26rpx; }
.reply-input {
  flex: 1;
  background: #FBF3E4;
  border: 2rpx solid rgba(36, 31, 26, 0.14);
  border-radius: 999rpx;
  padding: 0 28rpx;
  height: 76rpx;
  font-size: 28rpx;
}
.send { width: 150rpx; height: 76rpx; margin: 0 0 0 18rpx; font-size: 28rpx; }
