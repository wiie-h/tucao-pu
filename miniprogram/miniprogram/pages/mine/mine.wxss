.me { margin-bottom: 24rpx; }
.me-row { display: flex; align-items: center; }
.me-nick { font-size: 40rpx; font-weight: 700; margin-top: 6rpx; }
.roll-btn {
  font-size: 26rpx;
  background: #FBF3E4;
  border: 2rpx solid rgba(36, 31, 26, 0.14);
  border-radius: 999rpx;
  padding: 12rpx 26rpx;
}
.me-tip { margin-top: 18rpx; }

.stats {
  display: flex;
  background: rgba(255, 252, 246, 0.8);
  border: 1rpx solid rgba(36, 31, 26, 0.1);
  border-radius: 24rpx;
  padding: 24rpx 0;
  margin-bottom: 30rpx;
}
.stat { flex: 1; display: flex; flex-direction: column; align-items: center; }
.stat-num { font-size: 38rpx; font-weight: 700; }
.stat-key { font-size: 22rpx; color: #8C8178; margin-top: 4rpx; }

.label { font-size: 25rpx; color: #8C8178; margin: 0 0 18rpx 6rpx; letter-spacing: 2rpx; }
.go { width: 300rpx; margin: 40rpx auto 0; }

.about { margin-top: 20rpx; }
.about-title { font-weight: 700; margin-bottom: 12rpx; }
