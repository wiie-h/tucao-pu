.stats {
  display: flex;
  background: rgba(255, 252, 246, 0.8);
  border: 1rpx solid rgba(36, 31, 26, 0.1);
  border-radius: 24rpx;
  padding: 24rpx 0;
  margin-bottom: 24rpx;
}
.stat { flex: 1; display: flex; flex-direction: column; align-items: center; }
.stat-num { font-size: 42rpx; font-weight: 700; }
.stat-key { font-size: 22rpx; color: #8C8178; margin-top: 4rpx; }

.filter-bar { white-space: nowrap; margin-bottom: 10rpx; }
.filter-bar .chip { display: inline-block; margin-right: 14rpx; }

.sort-row { display: flex; align-items: center; margin: 12rpx 0 26rpx; }
.sort-item {
  font-size: 26rpx;
  color: #8C8178;
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  margin-right: 12rpx;
  background: rgba(36, 31, 26, 0.05);
}
.sort-on { background: #241F1A; color: #FBEFDC; font-weight: 600; }
.write-link { font-size: 27rpx; font-weight: 600; color: #FF4D3D; }

.loading { text-align: center; padding: 30rpx 0; font-size: 24rpx; }
